# Your GitLab Personal Access Token (PAT) with 'api' scope
GITLAB_PAT="glpat-YOUR_GITLAB_PAT"

# A custom secret key you choose for authenticating Claude Code with this local proxy
PROXY_API_KEY="your-custom-proxy-key-123"

# (Optional) Your GitLab Instance URL (defaults to https://gitlab.com)
# GITLAB_URL="https://gitlab.example.com"

# ----------------------------------------------------
# (Optional) For Browser OAuth Login Flow instead of PAT
# ----------------------------------------------------
# GITLAB_CLIENT_ID="your_oauth_application_id"
# GITLAB_CLIENT_SECRET="your_oauth_application_secret"
